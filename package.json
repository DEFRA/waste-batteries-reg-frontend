{
  "name": "waste-batteries-reg-frontend",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "cross-env AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "cross-env AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:watch": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "security-audit": "npm audit --audit-level=high --omit=dev && npm audit --audit-level=critical",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "imports": {
    "#/*": "./src/*",
    "#/test-helpers/*": "./test-helpers/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "^0.6.2",
    "@defra/cdp-metrics": "^0.6.1",
    "@defra/hapi-secure-context": "^0.4.1",
    "@defra/hapi-tracing": "^1.30.1",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@hapi/bell": "^13.2.1",
    "@hapi/catbox-memory": "^6.0.2",
    "@hapi/catbox-redis": "^7.1.0",
    "@hapi/cookie": "^12.0.1",
    "@hapi/crumb": "^9.0.1",
    "@hapi/hapi": "^21.4.12",
    "@hapi/inert": "^7.1.3",
    "@hapi/scooter": "^8.0.0",
    "@hapi/vision": "^7.0.3",
    "@hapi/yar": "^11.0.3",
    "blankie": "^5.0.0",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "date-fns": "^4.4.0",
    "govuk-frontend": "^6.6.0",
    "hapi-pino": "^13.0.0",
    "hapi-pulse": "^4.0.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.1",
    "jose": "^6.2.15",
    "lodash": "^4.18.1",
    "nunjucks": "^3.2.4",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@defra/hapi-connect": "^1.0.2",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "cssnano": "^9.9.0",
    "cssnano-preset-default": "^9.8.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-gds": "^3.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vitest-fetch-mock": "^0.4.5"
  },
  "overrides": {
    "@hapi/bell": {
      "joi": "17.13.9"
    },
    "@hapi/catbox-redis": {
      "joi": "17.13.9"
    },
    "@hapi/joi": "npm:joi@17.13.9",
    "hapi-pulse": {
      "joi": "18.3.1"
    },
    "baseline-browser-mapping": "^2.11.34",
    "browserslist": "^4.29.5",
    "chokidar": "^4.0.3",
    "minimatch": "^11.0.1",
    "postcss-selector-parser": "^7.1.7",
    "source-map-js": "^1.2.2",
    "svgo": "^4.1.0"
  }
}
